# Entorno: usa `production` únicamente en el despliegue final revisado.
MATRICULAPRO_DEPLOY_TARGET=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Beta pública reversible. true abre funciones de usuario sin activar ni alterar billing.
PUBLIC_BETA_MODE=true

# Supabase (anon/publishable es pública; service role solo servidor)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-server-only

# Titular legal: no se proporcionan valores ficticios. Producción queda bloqueada si faltan.
LEGAL_OWNER_FULL_NAME=
LEGAL_OWNER_NIF=
LEGAL_TRADE_NAME=IvanImports
LEGAL_OWNER_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_EMAIL=
NEXT_PUBLIC_SUPPORT_EMAIL=
LEGAL_REVIEW_COMPLETED=false

# Stripe: exclusivamente claves y objetos de TEST durante staging.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_PARTICULAR_1M=price_replace_me
STRIPE_PRICE_PARTICULAR_6M=price_replace_me
STRIPE_PRICE_PARTICULAR_12M=price_replace_me
STRIPE_PRICE_PROFESSIONAL_1M=price_replace_me
STRIPE_PRICE_PROFESSIONAL_6M=price_replace_me
STRIPE_PRICE_PROFESSIONAL_12M=price_replace_me

# Necesarios solo para habilitar la ampliación promocional de una licencia de un mes.
# Cupones test: amount_off 7900/12900 EUR, duration=once.
STRIPE_COUPON_PARTICULAR_1M_CREDIT=
STRIPE_COUPON_PROFESSIONAL_1M_CREDIT=

# Operación segura de pagos. Secreto aleatorio de 32+ caracteres, solo servidor.
PAYMENT_INCIDENT_ADMIN_SECRET=
# En staging/producción configura al menos uno de estos canales.
PAYMENT_INCIDENT_ALERT_WEBHOOK_URL=
PAYMENT_INCIDENT_ALERT_EMAIL=

# Rate limiting distribuido. Obligatorio en producción; memoria solo en desarrollo/test.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email transaccional (ver docs/RESEND_SUPABASE_SMTP_SETUP.md). Solo servidor.
# EMAIL_FROM debe ser una dirección real del dominio verificado; no inventarla.
RESEND_API_KEY=
EMAIL_FROM=
# Se usa para autorizar /api/cron/transactional-email. Mínimo 32 caracteres aleatorios.
TRANSACTIONAL_EMAIL_CRON_SECRET=
# Entre 1 y 50. El valor por defecto del servidor es 20.
TRANSACTIONAL_EMAIL_BATCH_SIZE=20
